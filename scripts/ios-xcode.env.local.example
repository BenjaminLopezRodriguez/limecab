# Copy to apps/<app>/ios/.xcode.env.local (gitignored) for physical device development.
#
# Set your Mac's LAN IP so Metro and the native build agree on the packager host.
# Run from repo root: ../../scripts/get-metro-host.sh
#
# iPhone USB / Personal Hotspot: en0 and bridge100 are often empty. Discover IP:
#   route get default | awk '/interface:/{print $2}'
#   ifconfig <iface> | awk '/inet /{print $2; exit}'
#   ifconfig | awk '/^[a-z]/ {iface=$1} /inet / && $2 != "127.0.0.1" {print iface, $2}'
#
# export REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.42
export NODE_BINARY=$(command -v node)
