# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://authjs.dev/getting-started/authentication/oauth
AUTH_SECRET=""

# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple — Services ID + a client secret JWT
# https://authjs.dev/getting-started/providers/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Optional. Shown on the sign-in page only when both are set.
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Created by Vercel CLI
ANALYSIS_PROVIDER="deterministic"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
PIPELINE_DRIVER="local"
STORAGE_DRIVER="local"
STRIPE_MCP_KEY="rk_test_your_restricted_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
VERCEL_OIDC_TOKEN=""


# Recommended for most uses
DATABASE_URL=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require

# Parameters for constructing your own connection string
PGHOST=your-host.neon.tech
PGHOST_UNPOOLED=your-host.neon.tech
PGUSER=your_user
PGDATABASE=your_database
PGPASSWORD=your_password

MAPBOX_TOKEN=pk.your_mapbox_token
# Same public token — Mapbox GL needs it in the browser. Restrict it by URL
# in the Mapbox account. The token must include Styles (tiles), Fonts,
# Directions, Geocoding (Places), and Search Box (Category search) — a
# styles-only token will 403 the map, route, address search, and rest stops.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Optional. Natural-language place search. Server-only — never NEXT_PUBLIC.
# Without Google, search uses Mapbox Places + Search Box only.
# Without DeepSeek, a local heuristic parses "closest 711" / "on Las Tunas".
GOOGLE_PLACES_API_KEY=""
DEEPSEEK_API_KEY=""

# Mint fake drivers and auto-advance the rider flow (looking → on the way →
# in ride → done) without a second signed-in driver. Defaults on in
# development. Set false to require a real /driver accept.
SIMULATE_DRIVERS=true

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require
POSTGRES_USER=your_user
POSTGRES_HOST=your-host.neon.tech
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=your_database
POSTGRES_URL_NO_SSL=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require

# Optional. The spatial place index (services/spatial). Server-only.
# Without both, the Shop store list and driver pit stops use Mapbox alone.
SPATIAL_API_URL=""
SPATIAL_API_KEY=""

# Payments rollout gates. All default OFF; read as === "true".
# PAYMENTS_ENABLED         -> create payment objects (Stripe TEST mode)
# REAL_CHARGES_ENABLED     -> permit live-mode keys. Blocked on legal review.
# PROVIDER_PAYOUTS_ENABLED -> let money reach a provider. Blocked on legal review.
PAYMENTS_ENABLED="false"
REAL_CHARGES_ENABLED="false"
PROVIDER_PAYOUTS_ENABLED="false"
