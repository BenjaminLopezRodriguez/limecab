{
  "name": "@lime/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Portable Lime-branded UI SDK. React Native-first, web-renderable.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract": "node --experimental-strip-types scripts/contract.ts",
    "test": "node --experimental-strip-types scripts/contract.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "react-native": "^0.83.0",
    "typescript": "^5.9.3"
  }
}
