{
  "name": "@lime/interaction-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Executable specification of Lime's interaction system. Extraction fork — production is authoritative.",
  "exports": {
    "./core": "./src/core/index.ts",
    "./policy": "./src/policy/index.ts",
    "./recipes": "./src/recipes/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./scenarios": "./src/scenarios/index.ts",
    "./harness": "./src/harness/index.ts",
    "./native": "./src/native/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "drift": "node --experimental-strip-types scripts/drift.ts",
    "coverage": "node --experimental-strip-types scripts/coverage.ts",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lime/ui": "link:../lime-ui"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "expo-blur": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.1.20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "expo-blur": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-svg": "^15.15.5",
    "storybook": "^9.1.20",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
